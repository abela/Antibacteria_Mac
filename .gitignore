# Repository-wide ignores.
# Unity-specific ignores live in Unity/AntiBacteria_Unity/.gitignore

# macOS
.DS_Store
._*

# Xcode (legacy Mac version in Mac/)
xcuserdata/
*.xcuserstate
DerivedData/
/Mac/build/
/Mac/build.log

# Backups left from the 2013 -> modern Xcode fix (originals are in git history)
*.orig

# Editors / IDEs
.idea/
.vscode/
*.swp

# Steam store screenshots (large, regenerated from the game; kept locally only)
/Steam/Screenshots/

# Steam trailer videos, audio and render frames (large; kept locally only)
/Steam/Trailer/

# Python bytecode (Steam art scripts)
__pycache__/

# Files waiting to be deleted by hand
/Steam/_to_delete/
