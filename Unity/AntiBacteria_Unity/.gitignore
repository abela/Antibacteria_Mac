# Unity project ignores (paths are relative to this folder: the Unity project root)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Memory captures and recordings (large, may contain sensitive data)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools (uncomment if used)
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin and personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio / Rider / VS Code caches
.vs/
.idea/
.gradle/

# Autogenerated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for ignored files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Test runner
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables build output
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
